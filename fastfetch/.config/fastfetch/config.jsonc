{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    },
    "color": {
      "1": "#9cba8d",
      "2": "#85a271"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 16,
      "paddingLeft": 2
    },
    "color": {
      "keys": "#85a271",
      "output": "#ddd5bc",
      "separator": "#6d7059",
      "title": "#9cba8d"
    },
    "percent": {
      "color": {
        "green": "#9cba8d",
        "yellow": "#a8ac79",
        "red": "#d78a51"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "  {user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "#9cba8d",
        "at": "#6d7059",
        "host": "#85a271"
      }
    },
    {
      "type": "custom",
      "format": "  ❦ ──────────────────────────",
      "outputColor": "#6d7059"
    },
    {
      "type": "os",
      "key": "  os"
    },
    {
      "type": "kernel",
      "key": "  kernel",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "  wm"
    },
    {
      "type": "terminal",
      "key": "  terminal"
    },
    {
      "type": "shell",
      "key": "󰆍  shell"
    },
    {
      "type": "packages",
      "key": "  packages"
    },
    "break",
    {
      "type": "cpu",
      "key": "  cpu"
    },
    {
      "type": "gpu",
      "key": "󰢮  gpu"
    },
    {
      "type": "memory",
      "key": "  memory"
    },
    {
      "type": "uptime",
      "key": "󰅐  uptime"
    },
    "break",
    {
      "type": "custom",
      "format": "  {#31}● {#32}● {#33}● {#34}● {#35}● {#36}● {#37}●"
    }
  ]
}
